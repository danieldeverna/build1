# Public application origin, for example http://localhost:3000
APP_URL=

# Authentication
AUTH_SECRET=
AUTH_ALLOWED_EMAIL=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Local development only. Never enable in production.
DEV_AUTH_BYPASS=

# PostgreSQL
DATABASE_URL=

# Base64-encoded 32-byte key used to encrypt provider credentials
CREDENTIAL_ENCRYPTION_KEY=

# Google Calendar OAuth (may reuse the sign-in OAuth client)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Optional Canvas OAuth configuration; leave blank until available
CANVAS_BASE_URL=
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
